+// Simple in-memory rate limit for authenticated search (per IP).
+const searchHits = new Map();
+const SEARCH_WINDOW_MS = 60 * 1000;
+const SEARCH_MAX_PER_WINDOW = 20;
+
+function rateLimitSearch(req, res, next) {
+  const ip = (req.headers["x-forwarded-for"] || req.ip || "unknown").toString().split(",")[0].trim();
+  const now = Date.now();
+  let entry = searchHits.get(ip);
+  if (!entry || now - entry.start > SEARCH_WINDOW_MS) {
+    entry = { start: now, count: 0 };
+    searchHits.set(ip, entry);
+  }
+  entry.count += 1;
+  if (entry.count > SEARCH_MAX_PER_WINDOW) {
+    return res.status(429).json({
+      success: false,
+      code: "RATE_LIMIT",
+      error: "Demasiados pedidos de pesquisa. Espera um minuto e tenta de novo."
+    });
+  }
+  next();
+}
