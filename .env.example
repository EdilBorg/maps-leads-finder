# Maps Leads Finder — variáveis de ambiente
# Copia este ficheiro:  cp .env.example .env
# Depois preenche apenas as chaves que fores usar.

# ── Apify (modo Completa) ──────────────────────────────────
# Obtém o token em: https://console.apify.com/account/integrations
APIFY_API_TOKEN=colocar_API_token_Apify_aqui

# ── OpenStreetMap / Overpass (modo Rápida) ─────────────────
# Não precisa de chave. Endpoints opcionais:
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Porta do servidor (opcional)
# PORT=3000
