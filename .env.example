# Maps Leads Finder — variáveis de ambiente
# cp .env.example .env  e preencha os valores reais (nunca faça commit do .env)

# ── Apify (modo Completa) ──────────────────────────────────
APIFY_API_TOKEN=colocar_API_token_Apify_aqui

# ── OpenStreetMap / Overpass (modo Rápida) ─────────────────
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# ── Autenticação OTP (obrigatório para acesso privado) ─────
# Único email autorizado a receber códigos (não é escolhido pelo cliente)
AUTH_EMAIL=seu_email_autorizado@exemplo.com

# SMTP Gmail (use palavra-passe de aplicação, não a password da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu_email_gmail@gmail.com
SMTP_PASS=colocar_app_password_gmail_aqui

# Forçar resolução IPv4 para o host SMTP (recomendado no Ubuntu; evita erros EDNS)
SMTP_FORCE_IPV4=true

# Segredo da sessão (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=colocar_segredo_aleatorio_longo_aqui

# production | development
NODE_ENV=development

# PORT=3000
