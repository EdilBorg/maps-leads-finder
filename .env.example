# ============================================
# MAPS LEADS FINDER - Variáveis de Ambiente
# ============================================
# Copia este ficheiro para .env e preenche as chaves
# NUNCA commits o ficheiro .env com chaves reais!

# --------------------------------------------
# OUTSCRAPER
# Obtém a tua chave em: https://outscraper.com/
# --------------------------------------------
OUTSCRAPER_API_KEY=colocar_API_key_Outscraper_aqui

# --------------------------------------------
# APIFY
# Obtém a tua chave em: https://console.apify.com/account/integrations
# --------------------------------------------
APIFY_API_TOKEN=colocar_API_token_Apify_aqui

# --------------------------------------------
# CONFIGURAÇÕES OPCIONAIS
# --------------------------------------------
# Máximo de resultados por pesquisa (padrão: 100)
MAX_RESULTS=100

# Filtro automático de empresas sem website (true/false)
FILTER_NO_WEBSITE=true
